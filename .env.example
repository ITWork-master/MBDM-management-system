# Copier ce fichier vers .env et renseigner les valeurs de votre projet Supabase.
# Ces deux valeurs sont publiques par conception (elles sont incluses dans le
# bundle client) : la securite repose sur les politiques RLS, pas sur leur secret.
# Ne jamais mettre la cle service_role ici : elle contourne toutes les policies.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon
